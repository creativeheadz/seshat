{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seshat",
  "version": "0.8.0-rc2",
  "identifier": "cc.seshat.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:9000",
    "beforeDevCommand": "npx gulp",
    "beforeBuildCommand": "npx gulp build"
  },
  "app": {
    "windows": [
      {
        "title": "Seshat",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
